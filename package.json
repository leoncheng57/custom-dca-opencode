{
  "name": "custom-dca-opencode",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "A custom local coding-agent IDE built on the OpenCode server API.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leoncheng57/custom-dca-opencode.git"
  },
  "workspaces": [
    "agent-skills"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:server": "tsx watch server/index.ts",
    "dev:ui": "vite",
    "build:ui": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:ui && npm run build:server && npm run build --workspace agent-skills-site",
    "start": "node dist/server/index.js",
    "service:install": "tsx scripts/launchd.ts install",
    "service:status": "tsx scripts/launchd.ts status",
    "service:logs": "tsx scripts/launchd.ts logs",
    "service:uninstall": "tsx scripts/launchd.ts uninstall",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.tools.json --noEmit && npm run typecheck --workspace agent-skills-site",
    "test": "vitest run && npm test --workspace agent-skills-site",
    "test:e2e": "playwright test",
    "screenshots": "tsx scripts/run-pr-screenshots.ts",
    "screenshots:local": "npm run screenshots -- --request-file tests/fixtures/pr-screenshots.json --output-dir screenshot-output --pr-number 0 --sha local"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "express": "^5.0.0",
    "lucide-react": "^1.33.0",
    "next-themes": "^0.4.6",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "qrcode-generator": "2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
