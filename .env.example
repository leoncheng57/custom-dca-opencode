# Copy to .env and adjust. .env is gitignored.

# ── OpenCode server ──────────────────────────────────────────────────────────
# The long-lived `opencode serve` this app talks to. One server hosts every
# project; the BFF selects a project per-request with ?directory=.
OPENCODE_URL=http://127.0.0.1:4096

# Basic auth, if the server was started with OPENCODE_SERVER_PASSWORD set.
# Leave unset for an unsecured (loopback- or tailnet-only) server.
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=

# ── This app ─────────────────────────────────────────────────────────────────
# Development BFF port. The supervised production BFF defaults to :3210 so it
# cannot silently collide with `npm run dev`; the Vite dev proxy reads this value.
PORT=3000

# Root under which project folders are offered in the new-session picker. The
# server scans at most 5 levels, 5,000 directories, and 500 results.
PROJECTS_DIR=~/Documents/Projects

# Server-global ordered project pins shared by desktop and phone clients.
# PROJECT_PINS_FILE=.state/project-pins.json

# Server-global ordered model pins shared by desktop and phone clients.
# MODEL_PINS_FILE=.state/model-pins.json

# OpenCode creates isolated worktrees below this root. The BFF accepts workspace
# paths only beneath PROJECTS_DIR or this directory.
OPENCODE_WORKTREE_ROOT=~/.local/share/opencode/worktree

# ── Mobile / Tailscale (optional) ────────────────────────────────────────────
# Public HTTP(S) origin encoded by the "Open on phone" QR action. Set this to
# the Tailscale Serve URL that reaches the app; unset falls back to the browser
# origin (which is usually localhost on desktop and therefore not phone-safe).
# PUBLIC_APP_URL=https://your-device.your-tailnet.ts.net

# Vite blocks non-localhost Host headers by default (DNS-rebinding protection).
# Set to "all", or a comma-separated allowlist, to reach the dev UI from a phone.
# VITE_ALLOWED_HOSTS=all

# Ports the read-only mobile preview proxy may reach on 127.0.0.1. Unset means
# disabled. The BFF and OpenCode ports are always removed from this list.
# PREVIEW_ALLOWED_PORTS=5173,4173

# ── Notifications (optional, Phase 5) ────────────────────────────────────────
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOPIC=
# NTFY_TOKEN=
# NOTIFICATION_PREFS_FILE=.state/notification-prefs.json
# Generate once with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# WEB_PUSH_SUBSCRIPTIONS_FILE=.state/web-push-subscriptions.json

# ── Forge integrations (optional, Phase 3) ───────────────────────────────────
# Used by the review panel and Project Planning. Creating planning issues needs
# Issues write access. Agent git operations still use host credentials directly.
# GITHUB_TOKEN=
# GITLAB_TOKEN=
# GITLAB_BASE_URL=https://gitlab.com
