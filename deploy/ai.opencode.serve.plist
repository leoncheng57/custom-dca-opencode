<?xml version="1.0" encoding="UTF-8"?>
<!--
  MANUAL TEMPLATE ONLY. Read deploy/README.md and replace every sentinel value
  in a working copy before installing it. Never overwrite
  an existing ~/Library/LaunchAgents/ai.opencode.serve.plist automatically.

  This direct-binary unit intentionally does not contain a password or load the
  repo .env. It is suitable only for an unsecured OpenCode server bound to
  loopback. Keep authenticated OpenCode under its existing supervisor instead.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.opencode.serve</string>

  <key>ProgramArguments</key>
  <array>
    <string>REPLACE_WITH_ABSOLUTE_OPENCODE_BINARY</string>
    <string>serve</string>
    <string>--hostname</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>REPLACE_WITH_OPENCODE_PORT</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>REPLACE_WITH_HOME_DIRECTORY</string>
    <key>PATH</key>
    <string>REPLACE_WITH_LAUNCHD_PATH</string>
    <key>NO_PROXY</key>
    <string>localhost,127.0.0.1</string>
    <key>OPENCODE_DISABLE_AUTOUPDATE</key>
    <string>1</string>
    <key>OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS</key>
    <string>true</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <!-- The log is append-only with no built-in rotation; rotate it yourself
       (newsyslog/logrotate). It reached 117 MB on the author's machine. -->
  <key>StandardOutPath</key>
  <string>REPLACE_WITH_LOG_DIRECTORY/opencode.launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_WITH_LOG_DIRECTORY/opencode.launchd.err.log</string>
</dict>
</plist>
