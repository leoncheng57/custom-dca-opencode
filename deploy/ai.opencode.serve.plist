<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd unit for the OpenCode server this app depends on.

  Optional OpenCode unit template. Read deploy/README.md before installing it.
  Never copy over an existing ~/Library/LaunchAgents/ai.opencode.serve.plist.

  Why each env var is here (all learned during the migration audit):
    OPENCODE_SERVER_PASSWORD  - `serve` is UNSECURED by default and prints a
                                warning. Basic auth covers the SSE streams too.
    OPENCODE_DISABLE_AUTOUPDATE - a background self-upgrade would swap the
                                binary under a long-lived daemon mid-session.
    NO_PROXY                  - required if any proxy is set, else localhost
                                requests loop back through it.
    OPENCODE_EXPERIMENTAL_BACKGROUND_SUBAGENTS - detach blocking subagents so a
                                parent session keeps working.
    HOME                      - so ~/.local/share/opencode resolves correctly.

  scripts/start-opencode.mjs loads the repo-root .env and derives the hostname,
  port, and credential from OPENCODE_URL / OPENCODE_SERVER_PASSWORD. This keeps
  the BFF and OpenCode endpoint from drifting.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.opencode.serve</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>node</string>
    <string>REPO_ROOT/scripts/start-opencode.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>REPO_ROOT</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/bsjl</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>NO_PROXY</key>
    <string>localhost,127.0.0.1</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <!-- The log is append-only with no built-in rotation; rotate it yourself
       (newsyslog/logrotate). It reached 117 MB on the author's machine. -->
  <key>StandardOutPath</key>
  <string>REPO_ROOT/.state/logs/opencode.launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>REPO_ROOT/.state/logs/opencode.launchd.err.log</string>
</dict>
</plist>
